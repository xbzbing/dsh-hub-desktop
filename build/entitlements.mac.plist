<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 与 electron-builder 26 的 mac 默认 entitlements 模板保持一致(2 键,
     T13 评审 F2/F3 修正):allow-jit 与 allow-unsigned-executable-memory 是
     Chromium(Electron)在 hardened runtime 下的标准需求,沿用工具默认。
     此前多出的两键已移除 —— allow-dyld-environment-variables 无书面理由;
     disable-library-validation 的「spawn 需要」论证有误(spawn/exec 不受
     library validation 约束,它管的是 dlopen 加载进本进程的库)。
     若未来确需放开某项:先补书面理由再添加,并同步 T13 小节与安全走查。 -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
</dict>
</plist>
