# --- macOS ---
.DS_Store

# --- 依赖 ---
node_modules/

# --- 构建产物 ---
dist/
out/
# 只忽略根目录的 release/(打包输出目录);必须锚定 —— 不锚定的 `release/`
# 会连带忽略 `scripts/release/`,让 T14 的发布脚本静默进不了仓库。
/release/
*.tsbuildinfo
*.tgz

# --- 日志 ---
*.log
npm-debug.log*

# --- 环境变量与密钥 ---
.env
.env.*
!.env.example

# --- IDE / 编辑器 ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- 测试覆盖率 ---
coverage/

# --- Playwright 产物 ---
test-results/
playwright-report/

# --- pnpm 本地兜底 store(全局 store 不可用时可能生成) ---
.pnpm-store/

# --- 应用运行时数据(实例注册表/SSH/审计/homes/runtimes) ---
hub-data/
# --- 本地开发过程记录(个人反馈/临时笔记,不入库) ---
docs/用户反馈-*.md
